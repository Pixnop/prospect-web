---
import Icon from './Icon.astro';
import logoMark from '../assets/logo.svg?raw';

// BASE_URL n'est pas garanti de finir par "/" : on le normalise pour pouvoir
// concaténer directement un slug sans risquer "prospect-webpremiers-pas".
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<header class="pr-topbar">
	<div class="pr-shell pr-topbar__inner">
		<a class="pr-topbar__brand" href={base}>
			<Fragment set:html={logoMark} />
			Prospect
		</a>
		<nav class="pr-topbar__nav" aria-label="Navigation principale">
			<a href={`${base}premiers-pas/`}>Documentation</a>
			<a href="https://github.com/Pixnop/Prospect">
				<Icon name="externalLink" size={15} />
				GitHub
			</a>
		</nav>
	</div>
</header>

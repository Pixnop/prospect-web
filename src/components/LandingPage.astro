---
// La landing complète, paramétrée par sa locale : les deux pages (racine anglaise,
// /fr/ française) partagent cette structure et ne diffèrent que par leurs chaînes.
import '../styles/fonts.css';
import '../styles/custom.css';
import Icon from './Icon.astro';
import logoMark from '../assets/logo.svg?raw';
import type { LandingStrings } from '../i18n/landing';

interface Props {
	t: LandingStrings;
}

const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = `${base}${t.docsPrefix}`;
const gettingStarted = `${docs}getting-started/`;
const twin = `${base}${t.twinPath}`;
const canonical = `${Astro.site?.toString().replace(/\/$/, '')}${base}${t.lang === 'fr' ? 'fr/' : ''}`;
const alternateEn = `${Astro.site?.toString().replace(/\/$/, '')}${base}`;
const alternateFr = `${alternateEn}fr/`;
---

<html lang={t.lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{t.title}</title>
		<meta name="description" content={t.description} />
		<link rel="icon" href={`${base}favicon.png`} type="image/png" />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="en" href={alternateEn} />
		<link rel="alternate" hreflang="fr" href={alternateFr} />
		<link rel="alternate" hreflang="x-default" href={alternateEn} />
		<meta name="generator" content={Astro.generator} />
		<script is:inline>
			// La landing suit le thème choisi dans la documentation : Starlight range son
			// choix dans localStorage sous `starlight-theme` ('light' | 'dark' | 'auto' ou
			// absent). Repli sur la préférence système. Script bloquant volontairement
			// minuscule, avant tout rendu, pour éviter un éclair de mauvais thème.
			(function () {
				var stored;
				try {
					stored = localStorage.getItem('starlight-theme');
				} catch (_) {
					stored = null;
				}
				var theme =
					stored === 'light' || stored === 'dark'
						? stored
						: window.matchMedia('(prefers-color-scheme: light)').matches
							? 'light'
							: 'dark';
				document.documentElement.dataset.theme = theme;
			})();
		</script>
	</head>
	<body class="pr-landing">
		<header class="pr-topbar">
			<div class="pr-shell pr-topbar__inner">
				<a class="pr-topbar__brand" href={base}>
					<Fragment set:html={logoMark} />
					Prospect
				</a>
				<nav class="pr-topbar__nav" aria-label={t.lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
					<a href={gettingStarted}>{t.nav.docs}</a>
					<a href="https://github.com/Pixnop/Prospect">
						<Icon name="externalLink" size={15} />
						{t.nav.github}
					</a>
					<a class="pr-topbar__lang" href={twin} rel="alternate" lang={t.lang === 'fr' ? 'en' : 'fr'}>
						{t.twinLabel}
					</a>
					<button id="pr-theme-toggle" class="pr-theme-toggle" type="button" aria-label={t.nav.theme}>
						<svg
							class="pr-theme-toggle__sun"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
							><circle cx="12" cy="12" r="4" /><path
								d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
							/></svg
						>
						<svg
							class="pr-theme-toggle__moon"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.75"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg
						>
					</button>
				</nav>
			</div>
		</header>
		<main>
			<section class="pr-hero">
				<div class="pr-shell">
					<p class="pr-overline pr-hero__eyebrow">{t.hero.eyebrow}</p>
					<div class="pr-hero__logo" set:html={logoMark} />
					<h1 class="pr-hero__title">Prospect</h1>
					<p class="pr-hero__tagline">{t.hero.tagline}</p>
					<div class="pr-hero__actions">
						<a class="pr-btn pr-btn--primary" href="https://github.com/Pixnop/Prospect">
							<Icon name="externalLink" size={16} />
							{t.hero.github}
						</a>
						<a class="pr-btn pr-btn--secondary" href={gettingStarted}>{t.hero.docs}</a>
					</div>
					<p class="pr-hero__status pr-overline">{t.hero.status}</p>
				</div>
				<div class="pr-strata" aria-hidden="true">
					<i></i><i></i><i></i><i></i><i></i>
				</div>
			</section>

			<section class="pr-section" id="features" aria-labelledby="features-title">
				<div class="pr-shell">
					<div class="pr-section__head">
						<span class="pr-overline pr-section__eyebrow">{t.features.eyebrow}</span>
						<h2 class="pr-section__title" id="features-title">{t.features.title}</h2>
						<p class="pr-section__lead">{t.features.lead}</p>
					</div>
					<div class="pr-features">
						{
							t.features.items.map((feature, index) => (
								<div class="pr-card pr-feature">
									<span class="pr-overline pr-feature__index">{String(index + 1).padStart(2, '0')}</span>
									<span class="pr-feature__icon">
										<Icon name={feature.icon} size={20} />
									</span>
									<h3>{feature.title}</h3>
									<p>{feature.text}</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<section class="pr-section pr-section--alt" id="screens" aria-labelledby="screens-title">
				<div class="pr-shell">
					<div class="pr-section__head">
						<span class="pr-overline pr-section__eyebrow">{t.gallery.eyebrow}</span>
						<h2 class="pr-section__title" id="screens-title">{t.gallery.title}</h2>
						<p class="pr-section__lead">{t.gallery.lead}</p>
					</div>
					<div class="pr-gallery">
						{
							t.gallery.items.map((shot) => (
								<figure class="pr-card pr-shot">
									<button
										class="pr-shot__button"
										type="button"
										aria-label={`${t.gallery.zoom} ${shot.caption}`}
										data-caption={shot.caption}
										data-dark={`${base}screenshots/${shot.src}`}
										data-light={`${base}screenshots/${shot.src.replace(/\.png$/, '-light.png')}`}
									>
										<img
											class="pr-shot__img pr-shot__img--dark"
											src={`${base}screenshots/${shot.src}`}
											alt={shot.alt}
											loading="lazy"
											decoding="async"
											width="1160"
											height="780"
										/>
										<img
											class="pr-shot__img pr-shot__img--light"
											src={`${base}screenshots/${shot.src.replace(/\.png$/, '-light.png')}`}
											alt={shot.alt}
											loading="lazy"
											decoding="async"
											width="1160"
											height="780"
										/>
									</button>
									<figcaption>{shot.caption}</figcaption>
								</figure>
							))
						}
					</div>
					<dialog id="pr-lightbox" class="pr-lightbox" aria-label={t.gallery.title}>
						<button id="pr-lightbox-close" class="pr-lightbox__close" type="button" aria-label={t.gallery.close}>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.75"
								stroke-linecap="round"
								aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg
							>
						</button>
						<img class="pr-shot__img pr-shot__img--dark" alt="" />
						<img class="pr-shot__img pr-shot__img--light" alt="" />
						<p class="pr-overline pr-lightbox__caption"></p>
					</dialog>
				</div>
			</section>

			<section class="pr-section" id="download" aria-labelledby="download-title">
				<div class="pr-shell">
					<div class="pr-card pr-download">
						<span class="pr-badge pr-download__badge">{t.download.badge}</span>
						<h2 class="pr-section__title" id="download-title">{t.download.title}</h2>
						<p>{t.download.body}</p>
						<div class="pr-download__actions">
							<a class="pr-btn pr-btn--primary" href="https://github.com/Pixnop/Prospect/releases/latest">
								<Icon name="download" size={16} />
								{t.download.github}
							</a>
							<a class="pr-btn pr-btn--secondary" href={gettingStarted}>
								<Icon name="download" size={16} />
								{t.download.build}
							</a>
						</div>
					</div>
				</div>
			</section>
		</main>
		<footer class="pr-footer">
			<div class="pr-shell pr-footer__inner">
				<p>
					{t.footer.license}
					<a href="https://github.com/Pixnop/Prospect/blob/main/LICENSE">{t.footer.licenseLinkLabel}</a>.
				</p>
				<nav class="pr-footer__links" aria-label={t.lang === 'fr' ? 'Liens du pied de page' : 'Footer links'}>
					<a href="https://github.com/Pixnop/Prospect">GitHub</a>
					<a href={gettingStarted}>{t.footer.docs}</a>
					<a href="https://mods.vintagestory.at">{t.footer.moddb}</a>
				</nav>
			</div>
		</footer>
		<script is:inline>
			// Lightbox de la galerie : chaque capture s'ouvre en grand dans le <dialog> natif,
			// avec ses deux variantes de thème (le CSS n'affiche que celle du thème courant).
			(function () {
				var lightbox = document.getElementById('pr-lightbox');
				var caption = lightbox.querySelector('.pr-lightbox__caption');
				var darkImg = lightbox.querySelector('.pr-shot__img--dark');
				var lightImg = lightbox.querySelector('.pr-shot__img--light');

				document.querySelectorAll('.pr-shot__button').forEach(function (button) {
					button.addEventListener('click', function () {
						darkImg.src = button.dataset.dark;
						lightImg.src = button.dataset.light;
						darkImg.alt = button.dataset.caption;
						lightImg.alt = button.dataset.caption;
						caption.textContent = button.dataset.caption;
						lightbox.showModal();
					});
				});

				document.getElementById('pr-lightbox-close').addEventListener('click', function () {
					lightbox.close();
				});
				// Clic sur le voile (la zone du dialog hors de son contenu) : fermeture.
				lightbox.addEventListener('click', function (event) {
					if (event.target === lightbox) {
						lightbox.close();
					}
				});
			})();

			// L'interrupteur de thème de la landing écrit la même clé que le sélecteur de la
			// documentation : les deux surfaces restent d'accord, dans les deux sens.
			document.getElementById('pr-theme-toggle').addEventListener('click', function () {
				var next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
				document.documentElement.dataset.theme = next;
				try {
					localStorage.setItem('starlight-theme', next);
				} catch (_) {
					/* stockage indisponible : le thème ne vaut que pour cette page */
				}
			});
		</script>
	</body>
</html>

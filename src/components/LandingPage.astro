---
// La landing complète, paramétrée par sa locale : les deux pages (racine anglaise,
// /fr/ française) partagent cette structure et ne diffèrent que par leurs chaînes.
import '../styles/fonts.css';
import '../styles/custom.css';
import Icon from './Icon.astro';
import logoMark from '../assets/logo.svg?raw';
import type { LandingStrings } from '../i18n/landing';

interface Props {
	t: LandingStrings;
}

const { t } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const docs = `${base}${t.docsPrefix}`;
const gettingStarted = `${docs}getting-started/`;
const twin = `${base}${t.twinPath}`;
const canonical = `${Astro.site?.toString().replace(/\/$/, '')}${base}${t.lang === 'fr' ? 'fr/' : ''}`;
const alternateEn = `${Astro.site?.toString().replace(/\/$/, '')}${base}`;
const alternateFr = `${alternateEn}fr/`;
---

<html lang={t.lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{t.title}</title>
		<meta name="description" content={t.description} />
		<link rel="icon" href={`${base}favicon.png`} type="image/png" />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang="en" href={alternateEn} />
		<link rel="alternate" hreflang="fr" href={alternateFr} />
		<link rel="alternate" hreflang="x-default" href={alternateEn} />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body class="pr-landing">
		<header class="pr-topbar">
			<div class="pr-shell pr-topbar__inner">
				<a class="pr-topbar__brand" href={base}>
					<Fragment set:html={logoMark} />
					Prospect
				</a>
				<nav class="pr-topbar__nav" aria-label={t.lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
					<a href={gettingStarted}>{t.nav.docs}</a>
					<a href="https://github.com/Pixnop/Prospect">
						<Icon name="externalLink" size={15} />
						{t.nav.github}
					</a>
					<a class="pr-topbar__lang" href={twin} rel="alternate" lang={t.lang === 'fr' ? 'en' : 'fr'}>
						{t.twinLabel}
					</a>
				</nav>
			</div>
		</header>
		<main>
			<section class="pr-hero">
				<div class="pr-shell">
					<p class="pr-overline pr-hero__eyebrow">{t.hero.eyebrow}</p>
					<div class="pr-hero__logo" set:html={logoMark} />
					<h1 class="pr-hero__title">Prospect</h1>
					<p class="pr-hero__tagline">{t.hero.tagline}</p>
					<div class="pr-hero__actions">
						<a class="pr-btn pr-btn--primary" href="https://github.com/Pixnop/Prospect">
							<Icon name="externalLink" size={16} />
							{t.hero.github}
						</a>
						<a class="pr-btn pr-btn--secondary" href={gettingStarted}>{t.hero.docs}</a>
					</div>
					<p class="pr-hero__status pr-overline">{t.hero.status}</p>
				</div>
				<div class="pr-strata" aria-hidden="true">
					<i></i><i></i><i></i><i></i><i></i>
				</div>
			</section>

			<section class="pr-section" id="features" aria-labelledby="features-title">
				<div class="pr-shell">
					<div class="pr-section__head">
						<span class="pr-overline pr-section__eyebrow">{t.features.eyebrow}</span>
						<h2 class="pr-section__title" id="features-title">{t.features.title}</h2>
						<p class="pr-section__lead">{t.features.lead}</p>
					</div>
					<div class="pr-features">
						{
							t.features.items.map((feature, index) => (
								<div class="pr-card pr-feature">
									<span class="pr-overline pr-feature__index">{String(index + 1).padStart(2, '0')}</span>
									<span class="pr-feature__icon">
										<Icon name={feature.icon} size={20} />
									</span>
									<h3>{feature.title}</h3>
									<p>{feature.text}</p>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<section class="pr-section pr-section--alt" id="screens" aria-labelledby="screens-title">
				<div class="pr-shell">
					<div class="pr-section__head">
						<span class="pr-overline pr-section__eyebrow">{t.gallery.eyebrow}</span>
						<h2 class="pr-section__title" id="screens-title">{t.gallery.title}</h2>
						<p class="pr-section__lead">{t.gallery.lead}</p>
					</div>
					<div class="pr-gallery">
						{
							t.gallery.items.map((shot) => (
								<figure class="pr-card">
									<img
										src={`${base}screenshots/${shot.src}`}
										alt={shot.alt}
										loading="lazy"
										decoding="async"
										width="1160"
										height="780"
									/>
									<figcaption>{shot.caption}</figcaption>
								</figure>
							))
						}
					</div>
				</div>
			</section>

			<section class="pr-section" id="download" aria-labelledby="download-title">
				<div class="pr-shell">
					<div class="pr-card pr-download">
						<span class="pr-badge pr-download__badge">{t.download.badge}</span>
						<h2 class="pr-section__title" id="download-title">{t.download.title}</h2>
						<p>{t.download.body}</p>
						<div class="pr-download__actions">
							<a class="pr-btn pr-btn--primary" href="https://github.com/Pixnop/Prospect">
								<Icon name="externalLink" size={16} />
								{t.download.github}
							</a>
							<a class="pr-btn pr-btn--secondary" href={gettingStarted}>
								<Icon name="download" size={16} />
								{t.download.build}
							</a>
						</div>
					</div>
				</div>
			</section>
		</main>
		<footer class="pr-footer">
			<div class="pr-shell pr-footer__inner">
				<p>
					{t.footer.license}
					<a href="https://github.com/Pixnop/Prospect/blob/main/LICENSE">{t.footer.licenseLinkLabel}</a>.
				</p>
				<nav class="pr-footer__links" aria-label={t.lang === 'fr' ? 'Liens du pied de page' : 'Footer links'}>
					<a href="https://github.com/Pixnop/Prospect">GitHub</a>
					<a href={gettingStarted}>{t.footer.docs}</a>
					<a href="https://mods.vintagestory.at">{t.footer.moddb}</a>
				</nav>
			</div>
		</footer>
	</body>
</html>
